
---
const { title = 'Behind the Breath', description = 'Evidence-informed perspectives on breathing, sleep and wellbeing.' } = Astro.props;
const pageTitle = title === 'Behind the Breath' ? title : `${title} | Behind the Breath`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f2" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Behind the Breath RSS" href="/rss.xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Behind the Breath home">BEHIND THE BREATH<span>.</span></a>
      <nav aria-label="Main navigation">
        <a href="/articles/">Articles</a>
        <a href="/category/breathing/">Breathing</a>
        <a href="/category/sleep/">Sleep</a>
        <a href="/category/mindfulness/">Mindfulness</a>
        <a href="/about/">About</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href="/">BEHIND THE BREATH<span>.</span></a>
        <p>The science of breathing, sleep and wellbeing.</p>
      </div>
      <div class="footer-links">
        <a href="/about/">About</a>
        <a href="/articles/">Articles</a>
        <a href="/rss.xml">RSS feed</a>
      </div>
      <p class="copyright">© {new Date().getFullYear()} Behind the Breath</p>
    </footer>
  </body>
</html>
