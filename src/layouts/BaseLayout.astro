
---
const { title = 'Behind the Breath', description = 'Evidence-informed perspectives on breathing, sleep and wellbeing.' } = Astro.props;
const pageTitle = title === 'Behind the Breath' ? title : `${title} | Behind the Breath`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f2" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Behind the Breath RSS" href="/rss.xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Behind the Breath home">BEHIND THE BREATH<span>.</span></a>
      <nav aria-label="Main navigation">
        <a href="/articles/">Articles</a>
        <a href="/category/breathing/">Breathing</a>
        <a href="/category/sleep/">Sleep</a>
        <a href="/category/mindfulness/">Mindfulness</a>
        <a href="/about/">About</a>
      </nav>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href="/">BEHIND THE BREATH<span>.</span></a>
        <p>The science of breathing, sleep and wellbeing.</p>
      </div>
      <div class="footer-links">
        <a href="/about/">About</a>
        <a href="/articles/">Articles</a>
        <a href="/rss.xml">RSS feed</a>
      </div>
      <p class="copyright">© {new Date().getFullYear()} Behind the Breath</p>
      <small>For education only; content is not a substitute for individual medical advice.</small>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #1d2b2a;
    background: #f7f6f2;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    margin: 0;
    background: #f7f6f2;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    line-height: 1.65;
    background: #f7f6f2;
    color: #1d2b2a;
  }

  a {
    color: inherit;
  }

  img {
    display: block;
    max-width: 100%;
  }

  .site-header {
    max-width: 1120px;
    margin: 0 auto;
    padding: 24px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid #e2e4dd;
  }

  .brand {
    color: #183f3a;
    text-decoration: none;
    font-size: 1.35rem;
    font-weight: 850;
    letter-spacing: .1em;
    white-space: nowrap;
  }

  .brand span {
    color: #d38b5d;
  }

  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 22px;
  }

  .site-header nav a,
  .footer-links a {
    color: #52625e;
    font-size: .9rem;
    text-decoration: none;
    transition: color .15s ease;
  }

  .site-header nav a:hover,
  .footer-links a:hover {
    color: #c26e3f;
  }

  main {
    min-height: 60vh;
  }

  .site-footer {
    max-width: 1120px;
    margin: 70px auto 0;
    padding: 32px 28px 28px;
    border-top: 1px solid #e2e4dd;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px;
    align-items: center;
    color: #687570;
  }

  .site-footer p {
    margin: 4px 0;
  }

  .footer-brand {
    font-size: 1.15rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  .site-footer .copyright,
  .site-footer small {
    grid-column: 1 / -1;
    margin: 0;
    font-size: .78rem;
  }

  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: .16em;
    font-size: .75rem;
    font-weight: 750;
    color: #b86d43;
  }

  .button {
    display: inline-block;
    padding: 11px 18px;
    border-radius: 5px;
    background: #204b44;
    color: white;
    text-decoration: none;
    font-weight: 650;
    font-size: .92rem;
    border: 1px solid #204b44;
  }

  .button:hover {
    background: #153a35;
  }

  .button.secondary {
    background: transparent;
    border: 1px solid #b8c3bc;
    color: #204b44;
  }

  .button.secondary:hover {
    background: #eeeee7;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin: 50px 0 20px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1.65rem;
    letter-spacing: -.03em;
  }

  .section-heading a {
    color: #52625e;
    font-size: .9rem;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .article-card {
    background: #fffefa;
    border: 1px solid #e6e6dc;
    border-radius: 10px;
    padding: 23px;
    display: flex;
    flex-direction: column;
    min-height: 225px;
  }

  .article-card .category {
    font-size: .72rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    font-weight: 750;
    color: #b86d43;
  }

  .article-card h3 {
    font-size: 1.2rem;
    line-height: 1.3;
    margin: 12px 0 8px;
    letter-spacing: -.02em;
  }

  .article-card h3 a {
    text-decoration: none;
  }

  .article-card h3 a:hover {
    color: #b86d43;
  }

  .article-card p {
    color: #66716d;
    font-size: .93rem;
    margin: 0 0 18px;
  }

  .article-card .date {
    margin-top: auto;
    font-size: .78rem;
    color: #84908b;
  }

  .prose {
    max-width: 760px;
    margin: 0 auto;
    padding: 55px 28px 20px;
  }

  .prose h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -.05em;
    margin: .4em 0;
  }

  .prose h2 {
    margin-top: 2em;
    line-height: 1.25;
  }

  .prose p,
  .prose li {
    color: #465550;
  }

  .prose a {
    color: #a95e37;
  }

  .prose blockquote {
    border-left: 3px solid #d38b5d;
    padding-left: 18px;
    color: #5c6c66;
  }

  .article-meta {
    font-size: .88rem;
    color: #77837d;
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
      padding: 20px;
    }

    .site-header nav {
      gap: 10px 17px;
    }

    .wrap {
      padding: 0 20px;
    }

    .article-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-footer {
      grid-template-columns: 1fr;
      padding: 28px 20px;
    }

    .site-footer .copyright,
    .site-footer small {
      grid-column: auto;
    }

    .prose {
      padding: 38px 20px 15px;
    }
  }
</style>
